# Порт бэкенда (слушает 0.0.0.0:$PORT)
PORT=3000

# Каталог с БД, записями, превью и логами
DATA_DIR=/data

# Максимальное число одновременно записываемых задач (1–2 рекомендуется для начала)
MAX_CONCURRENT=2

# CORS origins (через запятую). Пусто/* — разрешить любые.
ALLOWED_ORIGINS=*

# Глобальные настройки конвертации по умолчанию (см. раздел Settings в панели)
RESOLUTION=1920x1080
VIDEO_BITRATE=2000k
AUDIO_BITRATE=128k
FFMPEG_PRESET=veryfast
